      }).swiper-slide

      +art({
        img: './img/article-4',
        label: 'Figure skating',
        photo: './img/article-author-1',
        author: 'Jake Will.',
        date: '2023-06-01',
        title: 'Figure Skaters Push Boundaries With Quadruple Jumps',
        subtitle: 'The International Skating Union supports young talents and develops the sport around the world.',
      }).swiper-slide

      +art({
        img: './img/article-5',
        label: 'Tennis',
        photo: './img/article-author-2',
        author: 'Foxi.zacon',
        date: '2023-06-01',
