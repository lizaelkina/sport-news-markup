        subtitle: 'A new generation of tennis players will challenge the champions at the Grand Slam tournament beginning on Saturday.',
      }).swiper-slide

      +art({
        img: './img/article-6',
        label: 'Football',
        photo: './img/article-author-3',
        author: 'Bong Lozada',
        date: '2023-06-01',
