section#articles.articles.page__section.page__section_slider.js-section
  h2.articles__title
    | Sports Article
  div.swiper.js-swiper-articles
    div.swiper-wrapper
      +art({
        img: './img/article-1',
        label: 'Basketball',
        photo: './img/article-author-1',
        author: 'Jake Will.',
        date: '2023-06-04',
        title: '5 Exercises Basketball Players Should Be Using To Develop Strength',
        subtitle: 'This article was written by Jake Willhoite from Healthlisted.com Strength in basketball isn’t all about a massive body mass or ripped muscles.',
      }).swiper-slide

      +art({
        img: './img/article-2',
        label: 'Hockey',
        photo: './img/article-author-2',
        author: 'Foxi.zacon',
        date: '2023-06-03',
        title: 'Golden Knights out to fulfill owner`s quest to win Stanley Cup in 6th year',
        subtitle: 'The Vegas Golden Knights will play the Florida Panthers in the Stanley Cup Final beginning Saturday.',
      }).swiper-slide

      +art({
        img: './img/article-3',
        label: 'Badminton',
        photo: './img/article-author-3',
        author: 'Bong Lozada',
        date: '2023-06-01',
        title: '‘Outdoor’ Badminton Gets Support From Local Federation',
