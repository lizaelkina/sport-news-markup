footer.footer.page__footer.js-footer
  form.footer__form.js-newsletter-form
    h2.footer__title.js-newsletter-title
      span.footer__title-text(
        aria-hidden='true'
        data-title='default') Newsletter Subscription
      span.footer__title-text(
        aria-hidden='true'
        data-title='success') Thanks for subscribing
      span.visually-hidden.js-newsletter-status(
        aria-atomic='true'
        aria-live='polite') Newsletter Subscription
    div.footer__group
      input.footer__input(
        aria-label='enter email'
        required
        type='email'
        name='email'
        autocomplete='on'
        placeholder="shovon.khan0099@gmail.com")
      button(type='submit').footer__submit.js-newsletter-submit
        +svg('icon-arrow-send').footer__svg
  ul.footer__social
    li
      +social('facebook', 'Facebook').social_facebook
    li
      +social('instagram', 'Instagram').social_instagram
    li
      +social('twitter', 'Twitter').social_twitter
