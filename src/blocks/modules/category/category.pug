mixin category-card(data)
  li.category__card
    h3.category__label(class={'category__label_bottom': data.labelBottom})
      a(href='#').category__name= data.title
    div.category__img-wrapper
      +img(data.img, '').category__img

section#category.category.page__section.js-section
  h2.category__title
    | Category
  ul.category__list
    +category-card({
      img: './img/category-1',
      title: 'Football',
    })
    +category-card({
      img: './img/category-2',
      title: 'Basket ball',
      labelBottom: true,
    })
    +category-card({
      img: './img/category-3',
      title: 'Car sport',
    })
    +category-card({
      img: './img/category-4',
      title: 'Table tennis',
      labelBottom: true,
    })