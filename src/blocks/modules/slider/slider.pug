section.slider.page__section(aria-labelledby='section-slider-title')
  h2#section-slider-title.visually-hidden
    | News photo gallery
  div.slider__container
    div.swiper.js-swiper-slider
      div.swiper-wrapper

        div.swiper-slide
          +slide({
            img: './img/slide-1',
            label: 'Football',
            source: 'Agence France-Presse',
            date: '2023-06-04',
            title: 'Lionel Messi Leaving Ligue 1 Team Paris Saint-Germain, Club Confirms',
            subtitle: 'The EuroLeague Finals Top Scorer is the individual award for the player that gained the highest points in the EuroLeague Finals',
          }).slide_big

        div.swiper-slide
          +slide({
            img: './img/slide-2',
            label: 'Basketball',
            source: 'ESPN',
            date: '2023-06-03',
            title: 'Boston Celtics claim NBA Championship with game 7 victory',
            subtitle: 'Jayson Tatum`s career - high 51 points led the Celtics to a decisive 112-88 victory over the Philadelphia 76ers in the championship - deciding Game 7',
          }).slide_big

        div.swiper-slide
          +slide({
            img: './img/slide-3',
            label: 'Tennis',
            source: 'The Guardian',
            date: '2023-06-02',
            title: 'Alcaraz defends Wimbledon title in thrilling five-setter',
            subtitle: 'The Spanish star defeated Novak Djokovic 6-4, 3-6, 6-3, 4-6, 6-3 in an epic final lasting over four hours on Centre Court',
          }).slide_big

        div.swiper-slide
          +slide({
            img: './img/slide-4',
            label: 'Formula 1',
            source: 'Autosport',
            date: '2023-06-01',
            title: 'Antonelli makes history at Monaco Grand Prix',
            subtitle: 'The young Mercedes driver became the youngest-ever winner of the prestigious Monaco Grand Prix',
          }).slide_big

    div.slider__controls.swiper-controls
      +button-prev.js-slider-prev
      div.swiper-pagination
      +button-next.js-slider-next