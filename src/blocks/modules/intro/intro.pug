section#intro.intro.page__intro.js-section
  h1.visually-hidden Sport News
  +img('./img/intro-player', 'Basketball player')(loading='eager' fetchpriority='high').intro__img
  div.intro__left
    div.intro__container
      h2.intro__title
        | Top#[br]scorer to the&nbsp;final match
      div.intro__wrapper
        p.intro__subtitle
          | The EuroLeague Finals Top Scorer is&nbsp;the
          | individual award for the player that gained
          | the highest points in&nbsp;the EuroLeague Finals
        a(href='#').button.button_secondary.intro__button
          span.button__title-secondary
            | Continue reading
    div.intro__right
      div.intro__label
        h2.intro__label-text
          | Today
      ul.intro__news
        li
          +new-today({
            img: './img/intro-new-1',
            source: 'Race98',
            date: '2023-06-03',
            title: 'Ethiopian runners took the top four spots',
          })
        li
          +new-today({
            img: './img/intro-new-2',
            source: 'INDYCAR',
            date: '2023-06-03',
            title: 'IndyCar Detroit: Dixon quickest in second practice',
          })