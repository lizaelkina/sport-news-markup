mixin club(img, name)
  div.clubs-ranking__table-club
    +img(img, name).clubs-ranking__table-emblem
    p.clubs-ranking__table-name= name

section#clubs-ranking.clubs-ranking.page__double.js-section
  h2.clubs-ranking__title
    | Clubs Ranking
  div.clubs-ranking__container
    ul.clubs-ranking__table(aria-label='table')
      li.clubs-ranking__table-header(aria-label='rowheader')
        p.clubs-ranking__table-title.clubs-ranking__table-title_club Club
        p.clubs-ranking__table-title GP
        p.clubs-ranking__table-title W
        p.clubs-ranking__table-title D
        p.clubs-ranking__table-title L
        p.clubs-ranking__table-title F
        p.clubs-ranking__table-title A
        p.clubs-ranking__table-title GD

      li.clubs-ranking__table-row(aria-label='row')
        +club('./img/club-mancity', 'Manchester City')
        p.clubs-ranking__table-text 38
        p.clubs-ranking__table-text 29
        p.clubs-ranking__table-text 6
        p.clubs-ranking__table-text 3
        p.clubs-ranking__table-text 99
        p.clubs-ranking__table-text 26
        p.clubs-ranking__table-text 73

