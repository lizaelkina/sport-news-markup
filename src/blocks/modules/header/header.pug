header.header.page__header
  div.header__container
    h1.header__logo
      a(href='#')
        +img('./img/logo', 'Logo Sport News').header__img
    nav.header__nav.header-desktop
      ul.header__list
        li.header__item
          +link('Home', '#').link_active
        li.header__item
          +link('Category', '#')
        li.header__item
          +link('Trending News', '#')
        li.header__item
          +link('Recent News', '#')
        li.header__item
          +link('Clubs Ranking', '#')
        li.header__item
          +link('Sports Article', '#')
    button(type='button').button.header__search.header-desktop
      +svg('icon-search').button__svg
      span.button__title Search

    div.header__buttons.header-mobile
      button(type='button' aria-label='Start search' aria-expanded='false').button.button_icon
        +svg('icon-search').button__svg.button__svg_icon
      button(type='button' aria-label='Open menu' aria-expanded='false').burger
        span.burger__line