section#recent-news.recent-news.page__double.js-section
  h2.recent-news__title
    | Recent News
  div.recent-news__container
    div.recent-news__left
      +new-recent({
        img: './img/recent-new-1',
        day: 'Day 5',
        caption: 'Highlights',
        title: 'Baku 2023 World Taekwondo Championships',
      })
    div.recent-news__right
      ul.recent-news__list
        li
          +new-more({
            img: './img/recent-new-2',
            label: '#Pollar. 87',
            date: '2023-07-12',
            title: 'Baku 2023 Taekwondo Championships',
          })
        li
          +new-more({
            img: './img/recent-new-3',
            label: '#Goft. Toni',
            date: '2023-07-20',
            title: 'Open Championship Royal Liverpool Golf',
          })
        li
          +new-more({
            img: './img/recent-new-4',
            label: '#Cricket. Toni',
            date: '2023-07-27',
            title: 'Ireland Tour of England Test 2023',
          })
      a(href='#').button.recent-news__button
        span.button__title More
        +svg('icon-arrow-more').button__svg