section#recent-news.recent-news.page__double.js-section
  h2.recent-news__title
    | Recent News
  div.recent-news__container
    div.recent-news__left
      +new-recent({
        img: './img/recent-new-1',
        day: 'Day 5',
        caption: 'Highlights',
        title: 'Baku 2023 World Taekwondo Championships',
      })
    div.recent-news__right
      ul.recent-news__list
        li
          +new-more('./img/recent-new-2',
            '#Pollar. 87 - 12 July 2023',
            'Baku 2023 Taekwondo Championships')
        li
          +new-more('./img/recent-new-3',
            '#Goft. Toni - 20 July 2023',
            'Open Championship Royal Liverpool Golf')
        li
          +new-more('./img/recent-new-4',
            '#Cricket. Toni - 27 July 2023', 'Ireland Tour of England Test 2023')
      a(href='#').button.recent-news__button
        span.button__title More
        +svg('icon-arrow-more').button__svg