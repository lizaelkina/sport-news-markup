mixin art(src, label, photo, author, date, title, subtitle)
  article.art&attributes(attributes)
    div.art__img-wrapper
      +img(src, title).art__img
    div.label.label_small.art__label
      p.label__text.label__text_small= label
    a.art__container(href='#')
      div.art__author
        +img(photo, author).art__photo
        p.art__name= author
      time(datetime='2023-06').art__date= date
      hgroup.art__title-wrapper
        h3.art__title= title
        p.art__subtitle= subtitle