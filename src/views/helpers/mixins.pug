mixin img(src, alt)
  img(src=src + '.webp', alt=alt, loading='lazy')&attributes(attributes)

mixin svg(name)
  svg(data-svg=name aria-hidden='true' role='presentation')&attributes(attributes)
    use(href=`./img/sprites/sprite.svg#${name}`)

mixin link(name, href)
  a.link(href=href)&attributes(attributes)= name

mixin slide(src, label, description, title, subtitle)
  article.slide&attributes(attributes)
    +img(src, title).slide__img
    div.label
      p.label__text= label
    a.slide__title-wrapper(href='#')
      p.slide__description= description
      h3.slide__title= title
      if subtitle
        p.slide__subtitle= subtitle

mixin button-prev
  button(type='button').swiper-prev&attributes(attributes)
    +svg('icon-arrow-slide').swiper-prev__svg

mixin button-next
  button(type='button').swiper-next&attributes(attributes)
    +svg('icon-arrow-slide').swiper-next__svg