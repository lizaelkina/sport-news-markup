mixin img(src, alt)
  - attributes.loading = attributes.loading || 'lazy'
  img(src=src + '.webp', alt=alt)&attributes(attributes)

mixin svg(name)
  svg(data-svg=name aria-hidden='true' role='presentation')&attributes(attributes)
    use(href=`./img/sprites/sprite.svg#${name}`)

mixin date(isoDate)
  - const text = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(isoDate))
  time(datetime=isoDate).date-separator&attributes(attributes)= text

mixin button-prev
  button(type='button').swiper-prev&attributes(attributes)
    +svg('icon-arrow-slide').swiper-prev__svg

mixin button-next
  button(type='button').swiper-next&attributes(attributes)
    +svg('icon-arrow-slide').swiper-next__svg

mixin link(name, href)
  a.link(href=href)&attributes(attributes)= name

mixin social(svg, name)
  a(href='#' aria-label=name).social&attributes(attributes)
    +svg(svg).social__svg

mixin new-today(data)
  article.new&attributes(attributes)
    +img(data.img, '')(loading='eager').new__img.new__img_today
    div.new__container.new__container_today
      div.new__description.new__description_today
        a(href='#').new__source= data.source
        +date(data.date)
      h3
        a(href='#').new__title.new__title_today= data.title

mixin new-recent(data)
  article.new&attributes(attributes)
    +img(data.img, '').new__img.new__img_recent
    div.new__container.new__container_recent
      div.new__description.new__description_recent
        span= data.day
        span.text-separator= data.caption
      h3
        a(href='#').new__title.new__title_recent= data.title

mixin slide(data)
  article.slide&attributes(attributes)
    +img(data.img, '').slide__img
    div.label
      span.label__text= data.label
    div.slide__title-wrapper
      div.slide__description= description
        span= data.source
        +date(data.date)
      h3
        a(href='#').slide__title= data.title
      p.slide__subtitle= data.subtitle

mixin new-trending(data)
  article.new-trending&attributes(attributes)
    div.new-trending__img-wrapper
      +img(data.img, '').new-trending__img
    div.new-trending__container
      div.new-trending__description
        a(href='#').new-trending__source= data.source
        +date(data.date)
      h3
        a(href='#').new-trending__title= data.title
      p.new-trending__subtitle= data.subtitle

mixin new-more(data)
  article.new-more&attributes(attributes)
    div.new-more__img-wrapper
      +img(data.img, '').new-more__img
    div.new-more__container
      div.new-more__description
        span= data.label
        +date(data.date)
      h3
        a(href='#').new-more__title= data.title

mixin art(data)
  article.art&attributes(attributes)
    div.art__img-wrapper
      +img(data.img, '').art__img
    div.label.label_small.art__label
      span.label__text.label__text_small= data.label
    div.art__container
      a(href='#' target='_blank').art__author
        +img(data.photo, data.author).art__photo
        span.art__name= data.author
      +date(data.date).art__date
      div.art__title-wrapper
        h3
          a(href='#').art__title= data.title
        p.art__subtitle= data.subtitle