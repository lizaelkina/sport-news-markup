block variables

doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="apple-mobile-web-app-status-bar-style" content="black-translucent")
    meta(name="description" content=title)
    meta(name="author" content="Liza Elkina")
    title #{title}
    != faviconHtml
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@14.2.0/swiper-bundle.min.css")
    link(rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css")
    link(rel="stylesheet" href="styles/main.css")
  body.root
    div.page
      include ../../blocks/modules/header/header
      main.content
        block content
      include ../../blocks/modules/footer/footer
      include ../../blocks/modules/menu/menu
    script(src="js/main.js")
    script(defer src="https://cdn.jsdelivr.net/npm/swiper@14.2.0/swiper-bundle.min.js")
    script(defer src="https://unpkg.com/aos@2.3.1/dist/aos.js")
    block scripts
